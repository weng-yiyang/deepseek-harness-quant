# ============================================================
# DeepSeek HARNESS Quant · 环境变量配置模板
#
# 用法：复制本文件为 `.env`（已加入 .gitignore，不会提交到仓库），
#       按需取消注释并填写。所有变量均有安全默认值（回退到项目内
#       data/cache 或占位符），数据放项目内时通常无需设置任何变量。
#
# 加载规则（load_env.py）：
#   - 环境变量 > .env > 代码默认值
#   - .env 不覆盖已存在的环境变量
#   - 支持 # 注释、空行、export 前缀、单/双引号包裹
# ============================================================

# ---- 数据目录（脱敏后由环境变量驱动，替代原硬编码私有路径）----

# 主数据目录：bars.db / finance.db / stock_basic.db / circ_mv_map_full.csv
# 默认：<项目根>/data/cache
# QUANT_DATA_DIR=D:/your-data-dir/cache

# 因子池产出目录：pitch_signal_weights_*.json 等
# 默认：<项目根>/data/factorpool
# QUANT_FACTORPOOL_DIR=D:/your-codebase/因子池

# ---- 发布脚本脱敏规则（scripts/build_update.py）----
# 仅当需要让发布包的脱敏规则匹配你的真实私有标识时才设置；缺省用占位符。
# QUANT_PRIVATE_USER=your-username
# QUANT_PRIVATE_BRAND=your-brand
# QUANT_PRIVATE_CODEBASE=your-codebase-dir

# ---- 主缓存目录（既有机制：data/cache.py / launcher.py / live 等读取）----
# 默认：<项目根>/data/cache（launcher 启动时自动设置）
# LWQUANT_CACHE_DIR=D:/your-data-dir/cache

# ---- DeepSeek HARNESS ----
# HARNESS 运行时 home 目录（默认 harness/home，一般无需改）
# DSH_HOME=harness/home

# ---- 数据源凭据 ----
# Tushare token（财报主源；接入后让 AI 指导配置，或见 docs/快速开始.md）
# LW_TUSHARE_TOKEN=your-tushare-token
# 备用数据服务器 api_key（data/fetch_quality_backup.py，可选）
# LWQUANT_TUSHARE_BACKUP_KEY=your-backup-key

# ---- 网络 ----
# 数据抓取不走代理（多数据源脚本默认已 setdefault="*"，一般无需设）
# NO_PROXY=*
